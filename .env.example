# Copy to .env.local and fill in. Never commit the filled-in file.
# Every variable here must also be set in the Vercel project settings.

# ---------------------------------------------------------------- public site
# Canonical origin. Drives canonical URLs, hreflang, sitemap and OG image URLs.
NEXT_PUBLIC_SITE_URL=https://mphmeistrid.ee

# ------------------------------------------------------------ Cloudflare R2
# Dashboard > R2 > Manage API tokens. The token needs Object Read & Write on this bucket
# only. https://dash.cloudflare.com/?to=/:account/r2/api-tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Photos. A public custom domain is attached to THIS bucket.
R2_BUCKET=mph-meistrid-media

# Content JSON (projects, prices). Must be a SECOND bucket with NO public access:
# R2 grants public access per bucket, not per prefix, so keeping the JSON in the media
# bucket would publish unpublished drafts at a guessable URL. Omit only in local
# development, where it falls back to the bucket above.
R2_DATA_BUCKET=mph-meistrid-data

# Public URL the photos are served from. Attach a custom domain to the bucket
# (R2 > bucket > Settings > Public access > Custom domain) so images come off the
# Cloudflare CDN. The r2.dev development URL works but is rate limited — do not ship on it.
R2_PUBLIC_BASE_URL=https://media.mphmeistrid.ee

# ----------------------------------------------------------------- admin login
# One account. Generate both values with:  npm run hash-password -- "your password"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
AUTH_SECRET=

# ------------------------------------------------------- quote form (optional)
# Without these the quote form is hidden and the phone number is shown instead.
# Resend sends the message; Cloudflare Email Routing is what delivers info@ to the
# company's real inbox, and is configured in the Cloudflare dashboard, not here.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# --------------------------------------------------- spam protection (optional)
# https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
